{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fonds d'Entraide",
  "version": "0.1.0",
  "identifier": "bj.fonds.entraide",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Fonds d'Entraide",
        "width": 1320,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
