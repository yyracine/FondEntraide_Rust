{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fonds d'Entraide",
  "version": "0.1.0",
  "identifier": "bj.fonds.entraide",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Fonds d'Entraide",
        "width": 1320,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "publisher": "Fonds d'Entraide",
    "copyright": "© 2026 Fonds d'Entraide",
    "category": "Finance",
    "shortDescription": "Registre des cotisations familiales",
    "longDescription": "Gestion des cotisations du Fonds d'Entraide : hiérarchie des clans et familles, encaissements et reçus, sauvegardes, exports et impression.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"],
        "displayLanguageSelector": false
      }
    }
  }
}
